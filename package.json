{
  "name": "amtrak-find-trains-e2e",
  "version": "1.0.0",
  "description": "Playwright + Page Object test suite for the amtrak.com 'Find trains' search form",
  "private": true,
  "scripts": {
    "test": "playwright test --project=chromium-desktop",
    "test:headed": "playwright test --project=chromium-desktop --headed",
    "test:smoke": "playwright test --project=chromium-desktop --grep @smoke",
    "test:negative": "playwright test --project=chromium-desktop --grep @negative",
    "test:known-bugs": "KNOWN_BUGS=1 playwright test --grep @known-bug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "spec:coverage": "node scripts/spec-coverage.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run spec:coverage",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "test:visual:update:linux": "docker run --rm --ipc=host -v \"$PWD\":/work -w /work -e PW_OUTPUT_DIR=/tmp/pw/results -e PW_REPORTS_DIR=/tmp/pw/reports mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test --grep @visual --update-snapshots",
    "test:cross-browser": "playwright test --project=firefox-desktop --project=webkit-desktop --project=mobile-chrome --workers=2 --retries=1",
    "test:all": "playwright test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  }
}
