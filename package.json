{
  "name": "amtrak-find-trains-e2e",
  "version": "1.0.0",
  "description": "Playwright + Page Object test suite for the amtrak.com 'Find trains' search form",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:negative": "playwright test --grep @negative",
    "test:known-bugs": "KNOWN_BUGS=1 playwright test --grep @known-bug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "spec:coverage": "node scripts/spec-coverage.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run spec:coverage",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  }
}
