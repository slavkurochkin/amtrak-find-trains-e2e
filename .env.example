# Target environment (defaults to production amtrak.com)
BASE_URL=https://www.amtrak.com
# Time zone used for "today" when computing bookable dates. Amtrak's calendar follows the browser clock.
TEST_TZ=America/New_York
# Set to 1 to let the search request reach Amtrak instead of being intercepted (expect a bot-protection 403 under automation)
LIVE_SEARCH=0
