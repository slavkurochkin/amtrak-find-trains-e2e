# Environment under test: production (default) or qa. Profiles live in src/environments/.
TEST_ENV=production
# Address of the QA site, used when TEST_ENV=qa.
# QA_BASE_URL=
# Overrides the environment's address for any TEST_ENV.
# BASE_URL=
# Time zone used for "today" when computing bookable dates. Amtrak's calendar follows the browser clock.
TEST_TZ=America/New_York
